{"variants":[{"paths":["\/documentation\/mdocdatamodel18013\/credentialpolicy\/rotateuse"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:18MdocDataModel1801316CredentialPolicyO9rotateUseyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rotateUse"}],"symbolKind":"case","modules":[{"name":"MdocDataModel18013"}],"title":"CredentialPolicy.rotateUse","role":"symbol","roleHeading":"Case"},"kind":"symbol","abstract":[{"type":"text","text":"Policy that manages credential rotation by tracking usage count."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy\/rotateUse"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rotateUse"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"When a credential is used, its usage count is incremented, allowing the system to distribute load across multiple available credentials. This approach balances","type":"text"},{"text":" ","type":"text"},{"text":"security with performance considerations by enabling credential reuse while maintaining usage patterns for auditing and optimization purposes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Appropriate for scenarios requiring frequent authentication where the performance overhead of continuous credential generation would be prohibitive.","type":"text"},{"text":" ","type":"text"},{"text":"When ETSI TS 119 472-3 LimitedTime, RotatingBatch, PerRelyingParty reuse methods are applied, the rotateUse credential policy is used.","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013","doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy"]]},"references":{"doc://MdocDataModel18013/documentation/MdocDataModel18013":{"abstract":[],"identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013","role":"collection","url":"\/documentation\/mdocdatamodel18013","kind":"symbol","type":"topic","title":"MdocDataModel18013"},"doc://MdocDataModel18013/documentation/MdocDataModel18013/CredentialPolicy":{"navigatorTitle":[{"text":"CredentialPolicy","kind":"identifier"}],"url":"\/documentation\/mdocdatamodel18013\/credentialpolicy","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"CredentialPolicy","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy","role":"symbol","title":"CredentialPolicy","kind":"symbol","type":"topic"},"doc://MdocDataModel18013/documentation/MdocDataModel18013/CredentialPolicy/rotateUse":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rotateUse"}],"kind":"symbol","abstract":[{"type":"text","text":"Policy that manages credential rotation by tracking usage count."}],"title":"CredentialPolicy.rotateUse","url":"\/documentation\/mdocdatamodel18013\/credentialpolicy\/rotateuse","identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy\/rotateUse","type":"topic","role":"symbol"}}}