{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mdocdatamodel18013\/credentialpolicy\/rotateuse"]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","externalID":"s:18MdocDataModel1801316CredentialPolicyO9rotateUseyA2CmF","roleHeading":"Case","title":"CredentialPolicy.rotateUse","modules":[{"name":"MdocDataModel18013"}],"symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rotateUse","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy\/rotateUse","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013","doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rotateUse","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"When a credential is used, its usage count is incremented, allowing the system to distribute load across multiple available credentials. This approach balances","type":"text"},{"text":" ","type":"text"},{"text":"security with performance considerations by enabling credential reuse while maintaining usage patterns for auditing and optimization purposes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Appropriate for scenarios requiring frequent authentication where the performance overhead of continuous credential generation would be prohibitive.","type":"text"},{"text":" ","type":"text"},{"text":"When ETSI TS 119 472-3 LimitedTime, RotatingBatch, PerRelyingParty reuse methods are applied, the rotateUse credential policy is used.","type":"text"}]}]}],"abstract":[{"type":"text","text":"Policy that manages credential rotation by tracking usage count."}],"references":{"doc://MdocDataModel18013/documentation/MdocDataModel18013/CredentialPolicy/rotateUse":{"abstract":[{"type":"text","text":"Policy that manages credential rotation by tracking usage count."}],"role":"symbol","kind":"symbol","title":"CredentialPolicy.rotateUse","type":"topic","identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy\/rotateUse","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rotateUse","kind":"identifier"}],"url":"\/documentation\/mdocdatamodel18013\/credentialpolicy\/rotateuse"},"doc://MdocDataModel18013/documentation/MdocDataModel18013/CredentialPolicy":{"navigatorTitle":[{"kind":"identifier","text":"CredentialPolicy"}],"identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013\/CredentialPolicy","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CredentialPolicy"}],"title":"CredentialPolicy","kind":"symbol","url":"\/documentation\/mdocdatamodel18013\/credentialpolicy","type":"topic","role":"symbol","abstract":[]},"doc://MdocDataModel18013/documentation/MdocDataModel18013":{"identifier":"doc:\/\/MdocDataModel18013\/documentation\/MdocDataModel18013","role":"collection","title":"MdocDataModel18013","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/mdocdatamodel18013"}}}